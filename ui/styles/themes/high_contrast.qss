/* ===================================================================
   TEMA: ALTO CONTRASTE
   Máximo contraste (#000000/#ffff00) para baja visión
   =================================================================== */

QMainWindow {
    background-color: #000000;
}

QWidget#MainLauncher {
    background-color: #000000;
}

QLabel#HeaderLabel {
    font-size: 26px;
    font-weight: bold;
    color: #ffff00;
    margin-top: 10px;
}

QLabel#ClockLabel {
    font-size: 130px;
    font-weight: bold;
    color: #ffffff;
    margin: 0px;
    padding: 0px;
}

QLabel#DateLabel {
    font-size: 30px;
    color: #ffff00;
    font-weight: bold;
    margin-bottom: 20px;
}

QPushButton#AppButton {
    background-color: #000000;
    border: 4px solid #ffff00;
    border-radius: 12px;
    font-size: 22px;
    font-weight: bold;
    color: #ffffff;
    padding: 25px;
    min-width: 220px;
    min-height: 220px;
    text-align: center;
}

QPushButton#AppButton:hover {
    background-color: #333333;
    border-color: #ffffff;
    color: #ffff00;
}

QPushButton#AppButton:pressed {
    background-color: #ffff00;
    border: 4px solid #ffffff;
    color: #000000;
}

QPushButton#AppButton[flash="true"] {
    background-color: #ffff00;
    border: 4px solid #ffffff;
    color: #000000;
}

QPushButton#AdminButton {
    background-color: #000000;
    border: 3px solid #ffffff;
    border-radius: 6px;
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    min-width: 80px;
    min-height: 44px;
    padding: 0px 12px;
}

QPushButton#AdminButton:hover {
    color: #ffff00;
    border-color: #ffff00;
}

QPushButton#AdminButton:pressed {
    background-color: #ffff00;
    color: #000000;
}

QPushButton#EndMeetingButton {
    background-color: #ff0000;
    color: #ffffff;
    border: 3px solid #ffffff;
    border-radius: 10px;
    font-size: 18px;
    font-weight: bold;
    padding: 15px 30px;
}

QPushButton#EndMeetingButton:pressed {
    background-color: #cc0000;
    color: #ffff00;
}

QPushButton#RunningAppsButton {
    background-color: #ffff00;
    color: #000000;
    border: 3px solid #ffffff;
    border-radius: 10px;
    font-size: 18px;
    font-weight: bold;
    padding: 15px 30px;
}

QPushButton#RunningAppsButton:pressed {
    background-color: #ccaa00;
}

QPushButton#ShareScreenButton {
    background-color: #00ffff;
    color: #000000;
    border: 3px solid #ffffff;
    border-radius: 10px;
    font-size: 18px;
    font-weight: bold;
    padding: 15px 30px;
}

QPushButton#ShareScreenButton:hover {
    background-color: #ffffff;
    color: #000000;
    border-color: #00ffff;
}

QPushButton#ShareScreenButton:pressed {
    background-color: #00cccc;
    color: #000000;
}

QPushButton#ShareScreenButton:disabled {
    background-color: #333333;
    color: #777777;
    border-color: #555555;
}

QSlider::groove:horizontal {
    border: 2px solid #ffffff;
    height: 18px;
    background: #000000;
    margin: 2px 0;
    border-radius: 4px;
}

QSlider::sub-page:horizontal {
    background: #ffff00;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: #ffff00;
    border: 3px solid #ffffff;
    width: 48px;
    height: 48px;
    margin: -17px 0;
    border-radius: 24px;
}

QLabel#VolumeLabel {
    color: #ffff00;
    font-size: 18px;
    font-weight: bold;
}

QLabel#SignatureLabel {
    color: rgba(255, 255, 0, 0.5);
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 5px;
}

QDialog {
    background-color: #000000;
    border: 3px solid #ffff00;
    border-radius: 10px;
}

QDialog QLabel {
    color: #ffffff;
    font-weight: bold;
}

QDialog QCheckBox {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
    spacing: 8px;
}

QDialog QCheckBox::indicator {
    width: 24px;
    height: 24px;
    border: 3px solid #ffff00;
    border-radius: 3px;
    background-color: #000000;
}

QDialog QCheckBox::indicator:unchecked:hover {
    border-color: #ffffff;
}

QDialog QCheckBox::indicator:checked {
    background-color: #ffff00;
    image: url(assets/icons/check_white.png);
}

QDialog QTabWidget::pane {
    border: 3px solid #ffff00;
    background: #000000;
}

QDialog QTabBar::tab {
    background: #000000;
    color: #ffffff;
    font-weight: bold;
    padding: 10px 20px;
    border: 2px solid #ffffff;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QDialog QTabBar::tab:selected {
    background: #ffff00;
    color: #000000;
    font-weight: bold;
}

QDialog QListWidget {
    background-color: #000000;
    border: 2px solid #ffff00;
    border-radius: 4px;
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
}

QDialog QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #555555;
}

QDialog QListWidget::item:selected {
    background-color: #ffff00;
    color: #000000;
}

QLineEdit {
    padding: 10px;
    border: 3px solid #ffff00;
    border-radius: 4px;
    font-size: 16px;
    color: #ffffff;
    background-color: #000000;
    font-weight: bold;
}

QDialog QPushButton {
    background-color: #000000;
    color: #ffffff;
    border: 2px solid #ffff00;
    padding: 8px 15px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: bold;
}

QDialog QPushButton:hover {
    background-color: #333333;
    border-color: #ffffff;
}

QDialog QPushButton:pressed {
    background-color: #ffff00;
    color: #000000;
}

QPushButton#PrimaryButton {
    background-color: #ffff00;
    color: #000000;
    padding: 10px 20px;
    border-radius: 4px;
    font-size: 16px;
    font-weight: bold;
    border: 2px solid #ffffff;
}

QPushButton#PrimaryButton:pressed {
    background-color: #ccaa00;
}
