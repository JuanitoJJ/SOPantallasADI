/* ===================================================================
   TEMA: CLARO
   Fondo claro (#f5f7fa) con acentos en azul corporativo (#1976d2)
   =================================================================== */

QMainWindow {
    background-color: #f5f7fa;
}

QWidget#MainLauncher {
    background-color: #f5f7fa;
}

QLabel#HeaderLabel {
    font-size: 24px;
    font-weight: 600;
    color: #2c3e50;
    margin-top: 10px;
}

QLabel#ClockLabel {
    font-size: 120px;
    font-weight: bold;
    color: #1a1a1a;
    margin: 0px;
    padding: 0px;
}

QLabel#DateLabel {
    font-size: 28px;
    color: #5d6d7e;
    margin-bottom: 20px;
}

QPushButton#AppButton {
    background-color: #ffffff;
    border: 2px solid #d6dbdf;
    border-radius: 25px;
    font-size: 20px;
    font-weight: 600;
    color: #2c3e50;
    padding: 25px;
    min-width: 220px;
    min-height: 220px;
    text-align: center;
}

QPushButton#AppButton:hover {
    background-color: #ecf0f1;
    border-color: #1976d2;
}

QPushButton#AppButton:pressed {
    background-color: #1976d2;
    border: 3px solid #1565c0;
    color: #ffffff;
}

QPushButton#AppButton[flash="true"] {
    background-color: #1976d2;
    border: 3px solid #64b5f6;
    color: #ffffff;
}

QPushButton#AdminButton {
    background-color: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    color: #555555;
    font-size: 14px;
    min-width: 80px;
    min-height: 44px;
    padding: 0px 12px;
}

QPushButton#AdminButton:hover {
    color: #1a1a1a;
    background-color: rgba(0, 0, 0, 0.08);
}

QPushButton#AdminButton:pressed {
    background-color: rgba(0, 0, 0, 0.15);
    color: #1a1a1a;
}

QPushButton#EndMeetingButton {
    background-color: #d32f2f;
    color: white;
    border-radius: 15px;
    font-size: 18px;
    font-weight: bold;
    padding: 15px 30px;
}

QPushButton#EndMeetingButton:pressed {
    background-color: #b71c1c;
}

QPushButton#RunningAppsButton {
    background-color: #1976d2;
    color: white;
    border-radius: 15px;
    font-size: 18px;
    font-weight: bold;
    padding: 15px 30px;
}

QPushButton#RunningAppsButton:pressed {
    background-color: #1565c0;
}

QPushButton#ShareScreenButton {
    background-color: #00897b;
    color: white;
    border-radius: 15px;
    font-size: 18px;
    font-weight: bold;
    padding: 15px 30px;
}

QPushButton#ShareScreenButton:hover {
    background-color: #26a69a;
}

QPushButton#ShareScreenButton:pressed {
    background-color: #00796b;
}

QPushButton#ShareScreenButton:disabled {
    background-color: #b0bec5;
    color: #eceff1;
}

QSlider::groove:horizontal {
    border: 1px solid #d6dbdf;
    height: 16px;
    background: #ecf0f1;
    margin: 2px 0;
    border-radius: 8px;
}

QSlider::sub-page:horizontal {
    background: #1976d2;
    border-radius: 8px;
}

QSlider::handle:horizontal {
    background: #1976d2;
    border: 2px solid #1565c0;
    width: 44px;
    height: 44px;
    margin: -16px 0;
    border-radius: 22px;
}

QLabel#VolumeLabel {
    color: #5d6d7e;
    font-size: 16px;
    font-weight: bold;
}

QLabel#SignatureLabel {
    color: rgba(0, 0, 0, 0.25);
    font-size: 12px;
    font-style: italic;
    margin-bottom: 5px;
}

QDialog {
    background-color: #ffffff;
    border-radius: 10px;
    border: 1px solid #e0e0e0;
}

QDialog QLabel {
    color: #2c3e50;
}

QDialog QCheckBox {
    color: #2c3e50;
    font-size: 16px;
    spacing: 8px;
}

QDialog QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #1976d2;
    border-radius: 4px;
    background-color: #ffffff;
}

QDialog QCheckBox::indicator:unchecked:hover {
    border-color: #1565c0;
}

QDialog QCheckBox::indicator:checked {
    background-color: #1976d2;
    image: url(assets/icons/check_white.png);
}

QDialog QTabWidget::pane {
    border: 1px solid #e0e0e0;
    background: #ffffff;
}

QDialog QTabBar::tab {
    background: #f5f5f5;
    color: #555555;
    padding: 10px 20px;
    border: 1px solid #e0e0e0;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 2px;
}

QDialog QTabBar::tab:selected {
    background: #ffffff;
    color: #1976d2;
    font-weight: bold;
}

QDialog QListWidget {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 5px;
    color: #2c3e50;
    font-size: 16px;
}

QDialog QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #f0f0f0;
}

QDialog QListWidget::item:selected {
    background-color: #1976d2;
    color: white;
}

QLineEdit {
    padding: 10px;
    border: 2px solid #bdc3c7;
    border-radius: 5px;
    font-size: 16px;
    color: #2c3e50;
    background-color: #ffffff;
}

QDialog QPushButton {
    background-color: #ffffff;
    color: #2c3e50;
    border: 2px solid #bdc3c7;
    padding: 8px 15px;
    border-radius: 5px;
    font-size: 14px;
}

QDialog QPushButton:hover {
    background-color: #ecf0f1;
}

QDialog QPushButton:pressed {
    background-color: #d6dbdf;
}

QPushButton#PrimaryButton {
    background-color: #1976d2;
    color: white;
    padding: 10px 20px;
    border-radius: 5px;
    font-size: 16px;
    font-weight: bold;
    border: none;
}

QPushButton#PrimaryButton:pressed {
    background-color: #1565c0;
}
