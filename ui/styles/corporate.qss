/* corporate.qss - Estilo corporativo optimizado para pantallas táctiles */

QMainWindow {
    background-color: #1a1a1a; /* Fondo más oscuro y elegante */
}

QWidget#MainLauncher {
    background-color: #1a1a1a;
}

QLabel#HeaderLabel {
    font-size: 24px;
    font-weight: 300;
    color: #ecf0f1;
    margin-top: 10px;
}

QLabel#ClockLabel {
    font-size: 120px;
    font-weight: bold;
    color: #ffffff;
    margin: 0px;
    padding: 0px;
}

QLabel#DateLabel {
    font-size: 28px;
    color: #bdc3c7;
    margin-bottom: 20px;
}

/* Estilo para los botones de aplicaciones */
QPushButton#AppButton {
    background-color: #2c3e50;
    border: 2px solid #34495e;
    border-radius: 25px;
    font-size: 20px;
    font-weight: 600;
    color: #ffffff;
    padding: 25px;
    min-width: 220px;
    min-height: 220px;
    text-align: center;
}

QPushButton#AppButton:pressed {
    background-color: #3498db;
    border-color: #ffffff;
    transform: scale(0.98);
}

QPushButton#AdminButton {
    background-color: rgba(255, 255, 255, 0.05);
    border: none;
    border-radius: 5px;
    color: #555555;
    font-size: 14px;
}

QPushButton#EndMeetingButton {
    background-color: #e74c3c;
    color: white;
    border-radius: 15px;
    font-size: 18px;
    font-weight: bold;
    padding: 15px 30px;
}

QPushButton#EndMeetingButton:pressed {
    background-color: #c0392b;
}

QSlider::groove:horizontal {
    border: 1px solid #34495e;
    height: 12px;
    background: #2c3e50;
    margin: 2px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal {
    background: #3498db;
    border: 1px solid #3498db;
    width: 30px;
    height: 30px;
    margin: -10px 0;
    border-radius: 15px;
}

QLabel#VolumeLabel {
    color: #bdc3c7;
    font-size: 16px;
    font-weight: bold;
}

QDialog {
    background-color: #ffffff;
    border-radius: 10px;
}

QLineEdit {
    padding: 10px;
    border: 1px solid #bdc3c7;
    border-radius: 5px;
    font-size: 16px;
}

QPushButton#PrimaryButton {
    background-color: #3498db;
    color: white;
    padding: 10px 20px;
    border-radius: 5px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#PrimaryButton:pressed {
    background-color: #2980b9;
}
